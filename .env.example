# ---------------------------------------------------------------------------
# INFERA environment template. Copy to .env and fill in the values.
# Never commit .env. Never share real secrets.
# ---------------------------------------------------------------------------
NODE_ENV=development

PORT=3001
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000
API_BASE_PATH=/v1

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/v1/auth/discord/callback

# Comma separated Discord user IDs with platform-owner privileges.
INFERA_OWNER_IDS=
INFERA_DEFAULT_PREFIX=.

# Local development (SQLite):
DATABASE_URL=file:./dev.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql://infera:infera@localhost:5432/infera?schema=public

# Optional. Leave empty to use in-process cache/realtime/scheduler.
REDIS_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
JWT_SECRET=
ENCRYPTION_KEY=
WEBHOOK_SIGNING_SECRET=

WEB_APP_ORIGIN=http://localhost:3000
API_CORS_ORIGINS=http://localhost:3000

ROBLOX_API_BASE_URL=https://users.roblox.com

LOG_LEVEL=info
SENTRY_DSN=

SHARD_COUNT=auto
SHARD_MODE=auto
