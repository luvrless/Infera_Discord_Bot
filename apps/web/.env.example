# INFERA dashboard (apps/web). All values are optional.

# Base path or absolute URL of the INFERA API. Default: /v1 (same origin, proxied in dev).
# Production example when the dashboard and API share a parent domain:
#   VITE_API_BASE=https://api.infera.wtf/v1
VITE_API_BASE=/v1

# Realtime WebSocket URL. Default: derived from VITE_API_BASE.
#   VITE_WS_URL=wss://api.infera.wtf/v1/ws
VITE_WS_URL=

# Dev server only (vite.config.ts):
#   INFERA_API_PROXY  where /v1 is proxied to (default http://127.0.0.1:3001)
#   WEB_PORT          dev server port (default 3000)
