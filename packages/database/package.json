{
  "name": "@infera/database",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "prisma"],
  "scripts": {
    "generate": "prisma generate --schema prisma/schema.prisma",
    "generate:sqlite": "node scripts/make-sqlite-schema.mjs && prisma generate --schema prisma/schema.sqlite.prisma",
    "migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "push": "prisma db push --schema prisma/schema.prisma",
    "push:sqlite": "node scripts/make-sqlite-schema.mjs && prisma db push --schema prisma/schema.sqlite.prisma --skip-generate",
    "studio": "prisma studio --schema prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "tsx": "^4.19.2"
  }
}
